# Copy to .env and fill in. Keys come from the DB API Marketplace (Timetables API subscription).
DBDELAY_DB_CLIENT_ID=
DBDELAY_DB_API_KEY=

# Where raw XML and the poll log are written.
DBDELAY_DATA_DIR=./data

# Requests per minute the collector may use (free plan is reported as 60; stay below it).
DBDELAY_RATE_LIMIT_PER_MINUTE=50

# Optional Telegram alerts from `dbdelay health --alert`.
DBDELAY_TELEGRAM_BOT_TOKEN=
DBDELAY_TELEGRAM_CHAT_ID=
